(* IEC 61131-3 Standard Function Blocks: Bistable Latches *)

FUNCTION_BLOCK SR
  VAR_INPUT SET1, RESET : BOOL; END_VAR
  VAR_OUTPUT Q1 : BOOL; END_VAR
  Q1 := SET1 OR ((NOT RESET) AND Q1);
END_FUNCTION_BLOCK

FUNCTION_BLOCK RS
  VAR_INPUT SET, RESET1 : BOOL; END_VAR
  VAR_OUTPUT Q1 : BOOL; END_VAR
  Q1 := (NOT RESET1) AND (SET OR Q1);
END_FUNCTION_BLOCK
